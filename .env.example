# ============================================================================
# Arimana Bazar · Variables de Entorno para Conexión a Base de Datos (Supabase)
# ============================================================================

# 1. Configuración de API Supabase (PostgreSQL)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key

# 2. Conexión Directa / Pooler PostgreSQL a Supabase (Opcional para scripts y migraciones)
# Formato: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.tu-proyecto:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# 3. Entorno de Ejecución
NODE_ENV=development
